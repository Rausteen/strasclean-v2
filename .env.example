# ─────────────────────────────────────────────────────────────────────────
#  StrasClean — variables d'environnement
#  Copie ce fichier en .env.local (dev OU prod sur VPS) ou configure-les
#  dans Vercel. Tout est optionnel : laisser vide = bloc désactivé.
#
#  ⚠️ Les variables NEXT_PUBLIC_* sont inlinées au build : après tout
#  changement il faut RE-RUNNER `npm run build` (pas juste un restart).
# ─────────────────────────────────────────────────────────────────────────

# ── Google Analytics 4 (un seul compte, cross-section) ──────────────────
NEXT_PUBLIC_GA_ID=

# ── Google Ads AUTO (compte n°1) ────────────────────────────────────────
# Deux actions de conversion recommandées :
#   • CONTACT  (à passer en « secondaire » dans Google Ads) : clic WhatsApp /
#     téléphone / formulaire → libellé _LABEL (valeur fixe).
#   • RÉSERVATION (à passer en « principale ») : réservation en ligne confirmée
#     → libellé _RESERVATION_LABEL, avec la VALEUR RÉELLE du RDV (prix dynamique
#     — coche « Utiliser des valeurs différentes » dans Google Ads).
# Les 3 libellés par canal (_WA / _PHONE / _FORM) restent FACULTATIFS.
NEXT_PUBLIC_GOOGLE_ADS_AUTO_ID=
NEXT_PUBLIC_GOOGLE_ADS_AUTO_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_AUTO_RESERVATION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_AUTO_WA_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_AUTO_PHONE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_AUTO_FORM_LABEL=

# ── Google Ads MAISON (compte n°2) ──────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ADS_MAISON_ID=
NEXT_PUBLIC_GOOGLE_ADS_MAISON_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_MAISON_WA_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_MAISON_PHONE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_MAISON_FORM_LABEL=

# ── Meta / Facebook Pixel (optionnel) ───────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=

# ── Webhook Meta Lead Ads → Telegram (app/api/meta-leads) ───────────────
# Reçoit les leads des pubs Facebook/Instagram en instantané et les pousse
# sur Telegram. URL à déclarer dans Meta : https://strasclean.fr/api/meta-leads
META_VERIFY_TOKEN=          # chaîne secrète choisie par toi (= dans la config Meta)
META_APP_SECRET=            # secret de l'app Meta (vérif. de signature)
META_PAGE_ACCESS_TOKEN=     # token de page longue durée (perm. leads_retrieval)
TELEGRAM_BOT_TOKEN=         # token du bot (via @BotFather)
TELEGRAM_CHAT_ID=           # ton chat id (ou id de groupe)

# Polling de secours (app/api/meta-leads/poll) — marche SANS accès avancé.
# Un cron appelle .../api/meta-leads/poll?key=<META_POLL_SECRET> toutes les
# ~10 min → récupère les leads par lecture en masse et pousse les nouveaux.
META_LEAD_FORM_IDS=         # id(s) de formulaire, séparés par virgule (ex. 1577923333780417)
META_POLL_SECRET=           # secret protégeant l'URL du cron (réutilisé par le drip + rappels de RDV)

# ── Réservation en ligne (/reserver) ──
# Confirmation + rappel J-1 envoyés via Resend depuis RELANCE_EMAIL_FROM (bonjour@…).
# Rappels : un cron ~horaire appelle .../api/reservation/reminders?key=<META_POLL_SECRET>
# (envoie un rappel unique par RDV « à faire » à ~24 h de l'heure, idempotent).
# Les liens « Gérer ma réservation » (annuler/reporter) sont signés avec SESSION_SECRET.
#
# Avis Google : quand l'équipe marque un job « terminé » (/equipe), un 1er email
# de demande d'avis part automatiquement. Les relances (J+3, J+6) sont envoyées
# par un cron ~horaire : .../api/reservation/review-drip?key=<META_POLL_SECRET>.

# ── Relances email des prospects (app/api/leads/drip — J0/J3/J5 via Resend) ──
# Activé si RESEND_API_KEY est défini. Un cron ~horaire appelle
# .../api/leads/drip?key=<META_POLL_SECRET>. Piloté par le statut du lead
# (nouveau/à-relancer = envoie ; converti/perdu = stop). Désinscription RGPD
# incluse (signée avec SESSION_SECRET).
RESEND_API_KEY=             # clé API Resend (active email + relances)
RELANCE_EMAIL_FROM=         # expéditeur relances, ex: StrasClean <bonjour@strasclean.fr> (domaine vérifié Resend)
