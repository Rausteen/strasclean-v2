# ─────────────────────────────────────────────────────────────────────────
#  StrasClean — variables d'environnement
#  Copie ce fichier en .env.local (dev) ou configure-les dans Vercel /
#  sur ton serveur. Tout est optionnel : laisser vide = désactivé.
# ─────────────────────────────────────────────────────────────────────────

# Google Analytics 4 — ex: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Ads — ex: AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# (Optionnel) Libellé de conversion Google Ads — ex: AW-XXXXXXXXXX/AbCdEfGhIj
# Si défini, les clics WhatsApp/téléphone déclenchent cette conversion précise.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Meta / Facebook Pixel — ex: 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=
