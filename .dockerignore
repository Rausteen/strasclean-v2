# Ce qu'on N'envoie PAS dans le contexte de build (rapidité + sécurité)

# Node
node_modules
npm-debug.log*

# Next build cache (re-généré par le builder)
.next
.next-build
out

# Données runtime (DB SQLite) — montée en volume séparé
data
*.db
*.db-journal
*.db-wal
*.db-shm

# Tests / scripts dev
coverage
.nyc_output
*.test.ts
*.test.tsx
__tests__

# Outils dev
.vscode
.idea
*.swp
.DS_Store

# Env (les vrais secrets sont passés via docker-compose env_file)
.env
.env.local
.env*.local
.env.production

# Docker (pas besoin d'inclure Dockerfile dans le contexte)
Dockerfile
.dockerignore
docker-compose.yml

# Git
.git
.gitignore
.github

# Documentation / handoff
README.md
*.md
design_handoff_*

# Sources sensibles
service-account.json
*.pem
*.key
